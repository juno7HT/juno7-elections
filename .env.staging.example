# Staging only. Never reuse production secrets.
# Copy this file to .env.staging outside Git and fill real staging values there.
# Generate a staging ADMIN_TOKEN distinct from production.
# Verify explicitly that DATABASE_URL points to a database whose name contains "staging".

NODE_ENV=staging
PORT=3100
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@127.0.0.1:5432/juno7_elections_staging
ADMIN_TOKEN=CHANGE_ME_STAGING_ONLY
STAGING=true
