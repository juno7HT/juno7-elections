<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Juno7 Elections</title>

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <style>
    body { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial; background:#fff; }
    header { padding: 12px 16px; border-bottom: 1px solid #eee; display:flex; gap:12px; align-items:center; }
    #map { height: calc(100vh - 58px); }
    #status { font-size: 13px; color:#444; }
    #status b { color:#000; }
    .leaflet-popup-content-wrapper { border-radius: 12px; }
    .leaflet-popup-content { margin: 12px 14px; font-size: 14px; }
    .leaflet-interactive { outline: none !important; }
  </style>
</head>

<body>
  <header>
    <strong>Juno7 Elections</strong>
    <span id="status"><b>Statut :</b> initialisation…</span>
  </header>

  <div id="map"></div>
<div style="padding:15px;border-bottom:1px solid #eee;background:#fafafa">

<h3>Résultats nationaux (Démo)</h3>

<table style="border-collapse:collapse;font-size:14px">
<tr>
<th style="padding:6px 20px 6px 0">Candidat</th>
<th style="padding:6px 20px">Votes</th>
<th style="padding:6px 20px">%</th>
</tr>

<tr>
<td>Candidat A</td>
<td>1,245,300</td>
<td>52.4%</td>
</tr>

<tr>
<td>Candidat B</td>
<td>1,031,200</td>
<td>43.3%</td>
</tr>

<tr>
<td>Candidat C</td>
<td>102,000</td>
<td>4.3%</td>
</tr>

</table>

</div>

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>

  <script>
    (function () {
      const statusEl = document.getElementById("status");
      const setStatus = (txt) => { if (statusEl) statusEl.innerHTML = "<b>Statut :</b> " + txt; };

      if (!window.L) {
        setStatus("❌ Leaflet non chargé (CDN bloqué ?)");
        console.error("Leaflet (L) is not defined. CDN blocked?");
        return;
      }

      const clamp01 = (x) => Math.max(0, Math.min(1, x));

      // Carte
      setStatus("chargement de la carte…");
      const map = L.map("map", { zoomControl: true }).setView([19.0, -72.7], 8);

      // Fond OSM
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap",
      }).addTo(map);

      // Noms FR des départements (basé sur ISO_Code du GeoJSON)
      function getDeptName(props = {}) {
        const FR_BY_ISO = {
          "HT-AR": "Artibonite",
          "HT-CE": "Centre",
          "HT-GA": "Grand’Anse",
          "HT-NI": "Nippes",
          "HT-ND": "Nord",
          "HT-NE": "Nord-Est",
          "HT-NO": "Nord-Ouest",
          "HT-OU": "Ouest",
          "HT-SD": "Sud",
          "HT-SE": "Sud-Est",
        };

        if (props.ISO_Code && FR_BY_ISO[props.ISO_Code]) return FR_BY_ISO[props.ISO_Code];

        if (props.NAME && typeof props.NAME === "string") {
          return props.NAME.replace(/\s*Department\s*$/i, "").trim();
        }

        const candidates = [
          props.NAME_1, props.name_1, props.ADM1_FR, props.ADM1_EN,
          props.name, props.NOM_DEP, props.DEPT
        ].filter(Boolean);

        if (candidates.length) return String(candidates[0]).trim();
        return "Département";
      }

      // =========================
      // RÉSULTATS (depuis l’API)
      // /api/results retourne:
      // {
      //   "HT-OU": { winner:"A", winnerPct:0.64, total:15000, byCandidate:{A:9600,B:5400} },
      //   ...
      // }
      // =========================
      let apiResults = {}; // par ISO

      // Couleurs candidats
      const CANDIDATE_COLORS = {
        A: "#2563eb", // bleu
        B: "#dc2626", // rouge
        C: "#16a34a", // vert
        D: "#7c3aed", // violet
        E: "#ea580c", // orange
      };

      function hexToRgb(hex) {
        const h = String(hex).replace("#", "").trim();
        if (h.length !== 6) return { r: 100, g: 116, b: 139 };
        return {
          r: parseInt(h.slice(0, 2), 16),
          g: parseInt(h.slice(2, 4), 16),
          b: parseInt(h.slice(4, 6), 16),
        };
      }

      function rgbToHex({ r, g, b }) {
        const to2 = (n) => n.toString(16).padStart(2, "0");
        return "#" + to2(r) + to2(g) + to2(b);
      }

      function mixHex(c1, c2, t) {
        t = clamp01(t);
        const a = hexToRgb(c1);
        const b = hexToRgb(c2);
        return rgbToHex({
          r: Math.round(a.r + (b.r - a.r) * t),
          g: Math.round(a.g + (b.g - a.g) * t),
          b: Math.round(a.b + (b.b - a.b) * t),
        });
      }

      function getDeptFillColor(props) {
        const iso = props && props.ISO_Code ? props.ISO_Code : null;
        const r = iso && apiResults[iso] ? apiResults[iso] : null;

        // Pas de data => gris
        if (!r || !r.winner) return "#e2e8f0";

        const base = CANDIDATE_COLORS[r.winner] || "#64748b";
        const pct = clamp01(Number(r.winnerPct) || 0);

        // dégradé: clair -> couleur forte selon % gagnant
        return mixHex("#f8fafc", base, pct);
      }

      const baseStyle = {
        weight: 1,
        color: "#334155",
        fillOpacity: 0.85
      };

      const normalStyle = (feature) => {
        const props = feature?.properties || {};
        return {
          ...baseStyle,
          fillColor: getDeptFillColor(props),
        };
      };

      const hoverStyle = (feature) => {
        const props = feature?.properties || {};
        return {
          ...baseStyle,
          weight: 3,
          color: "#0f172a",
          fillColor: getDeptFillColor(props),
          fillOpacity: 1
        };
      };

      // Charge l’API results puis le GeoJSON
      async function loadAll() {
        try {
          setStatus("chargement des résultats…");
          const rr = await fetch("/api/results", { cache: "no-store" });
          if (!rr.ok) throw new Error("API /api/results: HTTP " + rr.status);
          apiResults = await rr.json();

          setStatus("chargement des départements…");
          const GEO_URL = "/geo/HTI_ADM1.geojson";
          const gr = await fetch(GEO_URL, { cache: "no-store" });
          if (!gr.ok) throw new Error("GeoJSON: HTTP " + gr.status + " " + gr.statusText);
          const geo = await gr.json();

          if (!geo || !geo.features || !geo.features.length) {
            throw new Error("GeoJSON vide ou invalide");
          }

          const layer = L.geoJSON(geo, {
            style: normalStyle,
            onEachFeature: (feature, lyr) => {
              const props = feature.properties || {};
              const name = getDeptName(props);
              const iso  = props.ISO_Code || "";

              const r = iso && apiResults[iso] ? apiResults[iso] : null;
              const winner = r?.winner ? r.winner : "N/A";
              const pct = r?.winnerPct ? Math.round(r.winnerPct * 100) : 0;
              const total = r?.total ?? "—";

              lyr.bindTooltip(name, { sticky: true });

              lyr.bindPopup(
                `<strong>${name}</strong><br>` +
                `<small>${iso}</small><br><br>` +
                `<b>Gagnant:</b> ${winner} (${pct}%)<br>` +
                `<b>Total:</b> ${total}`
              );

              lyr.on("mouseover", () => lyr.setStyle(hoverStyle(feature)));
              lyr.on("mouseout",  () => layer.resetStyle(lyr));
            },
          }).addTo(map);

          map.fitBounds(layer.getBounds(), { padding: [10, 10] });
          setStatus("✅ carte prête (résultats + couleurs)");
          console.log("GeoJSON loaded. Features:", geo.features.length);
        } catch (e) {
          console.error("Load error:", e);
          setStatus("❌ erreur : " + e.message);
          alert("Erreur chargement.\n\nDétail : " + e.message);
        }

        // ping santé API (debug)
        fetch("/health", { cache: "no-store" })
          .then((r) => r.json())
          .then((j) => console.log("API /health:", j))
          .catch(() => console.warn("API /health unreachable"));
      }

      loadAll();
    })();
  </script>
</body>
</html>
